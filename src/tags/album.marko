import type { albumsTable } from "../db/schema";

export type Input = typeof albumsTable.$inferSelect & {
  owned: boolean;
  isEditing?: boolean;
};

<const/isEditing=input.isEditing || false>

<form class="album-info" method="post" action="/albums">
  <input type="hidden" name="id" value=input.id>
  <input type="hidden" name="title" value=input.title>
  <input type="hidden" name="artist" value=input.artist>
  <if=input.image>
    <input type="hidden" name="image" value=input.image>
  </if>

  <img src=input.image alt="" width="80" height="80">
  <div>
    <a href="#">${input.title}</a>
    <p>${input.artist}</p>
  </div>

  <if=isEditing>
    <div class="album-info--trailing">
      <button name="intent" class={ "destructive": input.owned } value=(input.owned ? "remove" : "add")>
        ${input.owned ? "Remove" : "Add"}
      </button>
    </div>
  </if>
</form>

<style>
    .album-info {
        display: flex;
        --gutter: var(--space-lg);
        gap: var(--gutter);
        & > div {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        a:first-of-type {
            font-size: var(--font-lg);
            font-weight: bold;
        }

        img {
            corner-shape: squircle;
            border-radius: 10px;
        }

        .album-info--trailing {
            margin-inline-start: auto;
        }
    }
</style>
