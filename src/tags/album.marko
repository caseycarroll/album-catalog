import type { albumsTable } from "../db/schema";
import { albumImageUrl } from "../lib/albumImageUrl";

export type Input = typeof albumsTable.$inferSelect & {
  owned: boolean;
  isEditing?: boolean;
  stayOnPage?: boolean;
  addOnly?: boolean;
};

<const/isEditing=input.isEditing || false>
<let/owned=input.owned>
<let/saveError="">

<form
  class="album-info"
  method="post"
  action="/albums"
  async onSubmit(event, form) {
    if (!input.stayOnPage) return;
    event.preventDefault();
    saveError = "";

    const body = new FormData(form);
    body.set("intent", owned ? "remove" : "add");

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body,
        headers: { Accept: "application/json" },
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "Could not update the collection.");
      owned = data.owned;
    } catch (error) {
      saveError = error instanceof Error ? error.message : "Could not update the collection.";
    }
  }
>
  <input type="hidden" name="id" value=input.id>
  <input type="hidden" name="title" value=input.title>
  <input type="hidden" name="artist" value=input.artist>
  <if=input.stayOnPage>
    <input type="hidden" name="stayOnPage" value="true">
  </if>
  <if=input.image>
    <input type="hidden" name="image" value=albumImageUrl(input.id)>
  </if>

  <if=input.image>
    <img src=albumImageUrl(input.id) alt="" width="80" height="80">
  </if>
  <div>
    <a href="#">${input.title}</a>
    <p>${input.artist}</p>
  </div>

  <if=isEditing>
    <div class="album-info--trailing">
      <if=input.addOnly && owned>
        <span>In collection</span>
      </if>
      <else>
        <button name="intent" class={ "destructive": owned } value=(owned ? "remove" : "add")>
          ${owned ? "Remove" : "Add"}
        </button>
      </else>
    </div>
  </if>
</form>
<if=saveError>
  <p role="alert">${saveError}</p>
</if>

<style>
    .album-info {
        display: flex;
        --gutter: var(--space-lg);
        gap: var(--gutter);
        & > div {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        a:first-of-type {
            font-size: var(--font-lg);
            font-weight: bold;
        }

        img {
            corner-shape: squircle;
            border-radius: 10px;
        }

        .album-info--trailing {
            margin-inline-start: auto;
        }
    }
</style>
