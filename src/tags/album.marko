import type { albumsTable } from "../db/schema";
import { albumImageUrl } from "../lib/albumImageUrl";

export type Input = typeof albumsTable.$inferSelect & {
  owned: boolean;
  isEditing?: boolean;
  addOnly?: boolean;
};

<const/isEditing=input.isEditing || false>

<form
  class="album-info"
  method="post"
  action="/albums"
>
  <input type="hidden" name="id" value=input.id>
  <input type="hidden" name="title" value=input.title>
  <input type="hidden" name="artist" value=input.artist>
  <if=input.image>
    <input type="hidden" name="image" value=albumImageUrl(input.id)>
  </if>

  <if=input.image>
    <img src=albumImageUrl(input.id) alt="" width="80" height="80">
  </if>
  <div>
    <p>${input.title}</p>
    <p>${input.artist}</p>
  </div>

  <if=isEditing>
    <div class="album-info--trailing">
      <if=input.addOnly && input.owned>
        <span>In collection</span>
      </if>
      <else>
        <button name="intent" class={ "destructive": input.owned } value=(input.owned ? "remove" : "add")>
          ${input.owned ? "Remove" : "Add"}
        </button>
      </else>
    </div>
  </if>
</form>

<style>
    .album-info {
        display: flex;
        --gutter: var(--space-lg);
        gap: var(--gutter);
        & > div {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        p:first-of-type {
            font-size: var(--font-lg);
            font-weight: bold;
        }

        img {
            corner-shape: squircle;
            border-radius: 10px;
        }

        .album-info--trailing {
            margin-inline-start: auto;
        }
    }
</style>
