<div class="repel">
  <h2>Albums</h2>
  <a class="cta" href="/add"><span aria-hidden="true">➕ </span>Add Albums</a>
</div>

<await|albums|=$global.data.albums>
  <ul role="list">
    <const/sortedAlbums=albums.sort((a, b) => a.title.localeCompare(b.title))>
    <for|album| of=sortedAlbums by=album => album.title>
      <li>
        <album ...album owned=true/>
      </li>
    </for>
  </ul>
</await>
