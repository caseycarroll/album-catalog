<div class="cluster" style="--gutter: var(--space-lg); view-transition-name: actions;">
  <a class="cta" href="/add"><span aria-hidden="true">🔎 </span>Add by Title</a>
  <a class="cta" href="/scan"><span aria-hidden="true">📷 </span>Add by Barcode</a>
</div>

<h2 style="view-transition-name: albums-heading;">Albums</h2>

<const/sortedAlbums=$global.data.albums.sort((a, b) => a.artist.localeCompare(b.artist) || a.title.localeCompare(b.title))>
<ul role="list" style="view-transition-name: album-list;">
  <for|album| of=sortedAlbums by=album => album.title>
    <li>
      <album ...album owned=true/>
    </li>
  </for>
</ul>
