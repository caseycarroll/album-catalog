<div class="repel">
  <h2>Albums</h2>
  <a href="/add"><span aria-hidden="true">➕ </span>Add Albums</a>
</div>

<div class="repel">
  <div> </div>
  <div>
    <label for="album-sort-select">Sort by: </label>
    <select name="album-sort" id="album-sort-select">
      <option value="date">Date Added</option>
      <option value="a-z">A-Z</option>
    </select>
  </div>
</div>

<await|albums|=$global.data.albums>
  <ul role="list">
    <for|album| of=albums>
      <li>
        <album ...album owned=true/>
      </li>
    </for>
  </ul>
</await>
