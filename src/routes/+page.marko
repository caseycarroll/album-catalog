<div class="cluster">
  <a class="cta" href="/add"><span aria-hidden="true">🔎 </span>Add by Title</a>
  <a class="cta" href="/scan"><span aria-hidden="true">📷 </span>Add by Barcode</a>
</div>

<h2>Albums</h2>

<await|albums|=$global.data.albums>
  <ul role="list">
    <const/sortedAlbums=albums.sort((a, b) => a.artist.localeCompare(b.artist) || a.title.localeCompare(b.title))>
    <for|album| of=sortedAlbums by=album => album.title>
      <li>
        <album ...album owned=true/>
      </li>
    </for>
  </ul>
</await>
