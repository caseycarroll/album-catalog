<const/{ query, results: resultsPromise }=$global.data>

<div class="repel">
  <h2>Add album</h2>
  <a href="/">← Back to Catalog</a>
</div>



<search>
  <form method="get">
    <div class="cluster">
      <div class="search-field flow">
        <label for="album-search">Album name</label>
        <input id="album-search" type="search" name="q" value=query required>
      </div>
      <button type="submit">Search</button>
    </div>
  </form>
</search>

<try>
  <@placeholder>
    <loading />
  </@placeholder>
  <await|results|=resultsPromise>
    <if=results.length>
      <h3>Results</h3>
      <ul role="list">
        <for|{ album, owned }| of=results by=(result => result.album.id)>
          <li>
            <album ...album owned=owned isEditing />
          </li>
        </for>
      </ul>
    </if>
    <else if=query>
      <p>No albums found for “${query}”.</p>
    </else>
  </await>

  <@catch|err|>${err.message}</@catch>
</try>


<style>
    search .search-field {
        flex-grow: 1;
        --flow-space: var(--space-sm);
        input {
            width: 100%;
        }
    }
</style>
