<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" sizes="32x32" href="./favicon.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Casey's Album Collection">
    <title>${$global.meta.pageTitle || "Album Catalog"}</title>
  </head>
  <body>
    <main>
      <div class="content flow">
        <h1>Casey's Record Catalog</h1>
        <${input.content}/>
      </div>
    </main>
  </body>
</html>

<style>
    main {
        --main-gutter: 16px;
        display: grid;
        grid-template-columns:
            minmax(var(--main-gutter), 1fr)
            minmax(min(40ch, calc(100% - calc(var(--main-gutter) * 2))), 600px)
            minmax(var(--main-gutter), 1fr);
        grid-template-areas: "gutter-start content gutter-end";
        padding-block-start: calc(var(--space-xl) * 1.25);
    }
    .content {
        grid-area: content;
    }
</style>
