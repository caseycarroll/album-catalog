<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" sizes="32x32" href="./favicon.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Casey's Album Collection">
    <title>${$global.meta.pageTitle || "Album Catalog"}</title>
    <html-style>
      html {
        background-color: #f9f9f9;
      }
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }

      ::view-transition-group(add-by-title) {
        animation-duration: 500ms;
        animation-timing-function: cubic-bezier(0.8, -0.4, 0.5, 1);
      }

      /* Back link fades in as the heading transition settles */
      ::view-transition-new(back-link) {
        animation-delay: 350ms;
        animation-duration: 200ms;
        animation-timing-function: ease-out;
      }

      /* Back link fades out quickly when returning to the catalog */
      ::view-transition-old(back-link) {
        animation-delay: 0ms;
        animation-duration: 120ms;
        animation-timing-function: ease-in;
      }
    </html-style>
  </head>
  <body>
    <main>
      <div class="content flow">
        <h1>Casey's Record Catalog</h1>
        <${input.content}/>
      </div>
    </main>
  </body>
</html>

<style>
    main {
        --main-gutter: 16px;
        display: grid;
        grid-template-columns:
            minmax(var(--main-gutter), 1fr)
            minmax(min(40ch, calc(100% - calc(var(--main-gutter) * 2))), 600px)
            minmax(var(--main-gutter), 1fr);
        grid-template-areas: "gutter-start content gutter-end";
        padding-block-start: var(--space-xl);
    }
    .content {
        grid-area: content;
    }
</style>
