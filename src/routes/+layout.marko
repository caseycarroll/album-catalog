<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" sizes="32x32" href="./favicon.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Casey's Album Collection">
    <title>${$global.meta.pageTitle || "Album Catalog"}</title>
    <html-style>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }

      @keyframes slide-down {
        0% {
          transform: translateY(0%);
          opacity: 1;
        }

        75% {
            opacity: 0;
        }

        100% {
          transform: translateY(24px);
          opacity: 0;
        }
      }

      @keyframes slide-up {
        from {
          transform: translateY(24px);
          opacity: 0;
        }
        to {
          transform: translateY(0%);
          opacity: 1;
        }
      }

      @keyframes slide-x-in-right{
          from {
              opacity: 0;
              transform: translateX(-8px);
          }
          to {
              opacity: 1;
              transform: translateX(0);
          }
      }

      @keyframes slide-x-out-right {
          from {
              opacity: 1;
              transform: translateX(0);
          }
          to {
              opacity: 0;
              transform: translateX(8px);
          }
      }

      @keyframes slide-x-out-left {
          from {
              opacity: 1;
              transform: translateX(0);
          }
          to {
              opacity: 0;
              transform: translateX(-8px);
          }
      }

      ::view-transition-old(albums-heading),
      ::view-transition-old(album-list),
      ::view-transition-old(add-by-title),
      ::view-transition-old(search-bar) {
        animation-name: slide-down;
        animation-duration: 200ms;
        animation-timing-function: cubic-bezier(0.3, 0, 1, 1);
      }

      ::view-transition-new(albums-heading),
      ::view-transition-new(album-list),
      ::view-transition-new(add-by-title),
      ::view-transition-new(search-bar) {
        animation-name: slide-up;
        animation-delay: 125ms;
        animation-duration: 300ms;
        animation-timing-function: cubic-bezier(0, 0, 0, 1);
      }

      ::view-transition-new(album-list),
      ::view-transition-new(search-bar) {
          animation-delay: 175ms;
      }

      ::view-transition-new(back),
      ::view-transition-old(actions)
      {
          animation-name: slide-x-in-right;
          animation-timing-function: cubic-bezier(0.3, 0, 1, 1);
          animation-duration: 175px;
      }

      ::view-transition-new(back) {
          animation-delay: 100ms;
      }

      ::view-transition-old(actions) {
          animation-name: slide-x-out-right;
      }
    </html-style>
  </head>
  <body>
    <main>
      <div class="content flow">
        <h1>Casey's Collection</h1>
        <${input.content}/>
      </div>
    </main>
  </body>
</html>

<style>
  main {
    --main-gutter: 16px;
    display: grid;
    grid-template-columns:
      minmax(var(--main-gutter), 1fr)
      minmax(min(40ch, calc(100% - calc(var(--main-gutter) * 2))), 600px)
      minmax(var(--main-gutter), 1fr);
    grid-template-areas: "gutter-start content gutter-end";
    padding-block-start: var(--space-lg);
  }
  .content {
    grid-area: content;
  }
</style>
