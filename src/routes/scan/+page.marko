<a href="/" style={display: "block", "view-transition-name": "back"} class="cta">← Back to Collection</a>
<h2>Scan Barcode</h2>

<if=$global.data.barcode>
  <try>
    <await|result|=$global.data.scan>
      <if=result.status === "found">
        <album ...result.album owned=result.owned isEditing addOnly />
      </if>
      <else>
        <div class="album-placeholder">
          <p role="status">No album found for that barcode.</p>
        </div>
      </else>
    </await>
    <@placeholder>
      <div class="album-placeholder">
        <loading />
      </div>
    </@placeholder>
    <@catch|err|>
      <div class="album-placeholder error">
        <p role="alert">Error scanning barcode. Try again.</p>
      </div>
    </@catch>
  </try>
</if>
<else>
  <div class="album-placeholder"></div>
</else>

<barcode-scanner />

<style>
    .album-placeholder {
        width: 100%;
        border: 3px dotted black;
        border-radius: 12px;
        display: grid;
        padding: var(--space-md);
        align-items: center;
        min-height: 72px;

        &.error {
            border: 3px dotted red;
        }
    }
</style>
